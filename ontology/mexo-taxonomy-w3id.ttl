mexo:MetaheuristicTaxonomy a skos:ConceptScheme ;
    dcterms:created "2025-12-15"^^xsd:date ;
    dcterms:description "A pragmatic SKOS taxonomy of widely-used metaheuristic algorithms, grouped by family. Each algorithm concept includes an APA reference to its original publication."@en ;
    dcterms:isPartOf mexo:MEXO ;
    dcterms:modified "2026-09-01"^^xsd:date ;
    dcterms:title "MEXO taxonomy of metaheuristic algorithms"@en ;
