mexo:space-jsp a mexo:SearchSpace ;
    rdfs:label "Permutation-based dispatch/priority list space for JSP"^^xsd:string ;
    skos:note "Permutation encodes operation priorities (schedule derived by decoding rule)."^^xsd:string .

mexo:space-pfsp a mexo:SearchSpace ;
    rdfs:label "Permutation sequence space for PFSP"^^xsd:string ;
    skos:note "Permutation defines the common job order on all machines."^^xsd:string .

mexo:space-qap a mexo:SearchSpace ;
    rdfs:label "Permutation assignment space for QAP"^^xsd:string ;
    skos:note "Permutation π maps facility i -> location π(i)."^^xsd:string .

mexo:space-tsp a mexo:SearchSpace ;
    rdfs:label "Permutation tour space for TSP (Hamiltonian cycle encoding)"^^xsd:string ;
    skos:note "Permutation represents visit order  last-to-first edge closes the tour."^^xsd:string .

mexo:space-vrp a mexo:SearchSpace ;
    rdfs:label "Permutation with route separators for CVRP"^^xsd:string ;
    skos:note "Permutation encodes customer order plus delimiters or split procedure to build routes."^^xsd:string .

