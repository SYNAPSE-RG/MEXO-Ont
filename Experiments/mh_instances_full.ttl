@prefix dct: <http://purl.org/dc/terms/> .
@prefix mexo: <https://w3id.org/mexo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mexo:PermutationRepresentation a rdfs:Class ;
    rdfs:label "Permutation Representation"^^xsd:string ;
    rdfs:subClassOf mexo:Representation .

mexo:TreeRepresentation a rdfs:Class ;
    rdfs:label "Tree Representation"^^xsd:string ;
    rdfs:subClassOf mexo:Representation .

mexo:c-jsp-precedence a mexo:Constraint ;
    rdfs:label "Operations must respect technological order"^^xsd:string ;
    mexo:constraintType mexo:ct-precedence ;
    mexo:hasProblem mexo:problem-jsp ;
    skos:note "Job precedence constraint"^^xsd:string .

mexo:c-tsp-perm a mexo:Constraint ;
    rdfs:label "Each city visited exactly once"^^xsd:string ;
    mexo:constraintType mexo:ct-equality ;
    mexo:hasProblem mexo:problem-tsp ;
    skos:note "Permutation validity constraint"^^xsd:string .

mexo:c-vrp-visitonce a mexo:Constraint ;
    rdfs:label "Each customer visited exactly once"^^xsd:string ;
    mexo:constraintType mexo:ct-equality ;
    mexo:hasProblem mexo:problem-vrp ;
    skos:note "Permutation visit constraint"^^xsd:string .

mexo:exp-abc001 a mexo:Experiment ;
    rdfs:label "Artificial Bee Colony (ABC) baseline"^^xsd:string ;
    mexo:hasStoppingCriterion mexo:stop-feval-10000 ;
    mexo:numberOfRuns 30 ;
    mexo:randomSeed 42 ;
    mexo:targetsProblem mexo:problem-continuous ;
    mexo:usesAlgorithm mexo:abc-001 ;
    skos:note "swarm/population baseline"^^xsd:string .

