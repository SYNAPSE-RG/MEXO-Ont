    mexo:parameterSymbol "pf"^^xsd:string ;
    mexo:parameterType mexo:ptype-real ;
    mexo:parameterValue 0.7 .

mexo:p-sspr001-001 a mexo:Parameter ;
    mexo:parameterName "Reference set size"^^xsd:string ;
    mexo:parameterSymbol "b"^^xsd:string ;
    mexo:parameterType mexo:type-int ;
    mexo:parameterValue 10 .

mexo:p-sspr001-002 a mexo:Parameter ;
    mexo:parameterName "Diversification size"^^xsd:string ;
    mexo:parameterSymbol "d"^^xsd:string ;
    mexo:parameterType mexo:type-int ;
    mexo:parameterValue 20 .

mexo:p-tlbo001-001 a mexo:Parameter ;
    mexo:parameterName "Population size"^^xsd:string ;
    mexo:parameterSymbol "N"^^xsd:string ;
    mexo:parameterType mexo:type-int ;
    mexo:parameterValue 30 .

mexo:p-tlbo001-002 a mexo:Parameter ;
    mexo:parameterName "Teaching factor"^^xsd:string ;
    mexo:parameterSymbol "TF"^^xsd:string ;
    mexo:parameterType mexo:type-int ;
    mexo:parameterValue 2 .

mexo:p-ts001-001 a mexo:Parameter ;
    mexo:parameterName "Tabu tenure"^^xsd:string ;
    mexo:parameterSymbol "tenure"^^xsd:string ;
    mexo:parameterType mexo:type-int ;
    mexo:parameterValue 7 .

mexo:p-vns001-001 a mexo:Parameter ;
    mexo:parameterName "Max neighborhood index"^^xsd:string ;
    mexo:parameterSymbol "kmax"^^xsd:string ;
    mexo:parameterType mexo:type-int ;
    mexo:parameterValue 5 .

mexo:p-woa001-001 a mexo:Parameter ;
    mexo:parameterName "Population size"^^xsd:string ;
    mexo:parameterSymbol "N"^^xsd:string ;
    mexo:parameterType mexo:type-int ;
    mexo:parameterValue 30 .

mexo:p-woa001-002 a mexo:Parameter ;
    mexo:parameterName "a start"^^xsd:string ;
    mexo:parameterSymbol "a0"^^xsd:string ;
    mexo:parameterType mexo:ptype-real ;
    mexo:parameterValue 2.0 .

mexo:paes-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-paes001-001,
        mexo:p-paes001-002 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:PAES ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "PAES (archive=100, mut=0.1)"^^xsd:string .

mexo:phys-chem-001 a mexo:MetaheuristicAlgorithm ;
    skos:broader mexo:PhysicsChemistryInspiredMetaheuristics ;
    skos:definition "category"^^xsd:string ;
    skos:prefLabel "Physics/chemistry-inspired metaheuristics (category)"^^xsd:string .

mexo:problem-feature-selection a mexo:OptimizationProblem ;
    rdfs:label "Feature Selection"^^xsd:string ;
    mexo:hasObjectiveFunction mexo:obj-feature-selection ;
    dct:source "UCI datasets"^^xsd:string ;
    skos:note "ML combinatorial optimization"^^xsd:string .

mexo:problem-knapsack a mexo:OptimizationProblem ;
    rdfs:label "Knapsack Problem"^^xsd:string ;
    mexo:hasObjectiveFunction mexo:obj-knapsack-max ;
    dct:source "OR-Library"^^xsd:string ;
    skos:note "binary optimization problem"^^xsd:string .

mexo:problem-pfsp a mexo:OptimizationProblem ;
    rdfs:label "PFSP (Taillard instances)"^^xsd:string ;
    mexo:hasConstraint mexo:c-pfsp-sequence ;
    mexo:hasObjectiveFunction mexo:obj-pfsp-makespan ;
    mexo:hasSearchSpace mexo:space-permutation ;
    dct:source "Taillard benchmark"^^xsd:string ;
    skos:note "flow shop permutation"^^xsd:string .

mexo:problem-qap a mexo:OptimizationProblem ;
    rdfs:label "QAP (QAPLIB instances)"^^xsd:string ;
    mexo:hasConstraint mexo:c-qap-assignment ;
    mexo:hasObjectiveFunction mexo:obj-qap-min ;
    mexo:hasSearchSpace mexo:space-permutation ;
    dct:source "QAPLIB"^^xsd:string ;
    skos:note "baseline permutation problem"^^xsd:string .

mexo:pso-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-pso001-001,
        mexo:p-pso001-002,
        mexo:p-pso001-003,
        mexo:p-pso001-004 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:ParticleSwarmOptimization ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "PSO (gbest, w=0.7, c1=c2=1.5, N=20)"^^xsd:string .

mexo:rrt-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-rrt001-001 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:RecordToRecordTravel ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "RRT (threshold=0.01, window=50)"^^xsd:string .

mexo:sa-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-sa001-001,
        mexo:p-sa001-002 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:SimulatedAnnealing ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "SA (T0=100, alpha=0.95, L=50)"^^xsd:string .

mexo:sca-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-sca001-001,
        mexo:p-sca001-002 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:SineCosineAlgorithm ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "SCA (N=30, a=2->0)"^^xsd:string .

mexo:scatter-pr-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-sspr001-001,
        mexo:p-sspr001-002 ;
    mexo:usesRepresentation mexo:PermutationRepresentation ;
    skos:broader mexo:ScatterSearchPathRelinking ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "Scatter Search & Path Relinking (refSet=10, diversify=on, PR=on)"^^xsd:string .

mexo:sfla-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-sfla001-001,
        mexo:p-sfla001-002,
        mexo:p-sfla001-003 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:ShuffledFrogLeapingAlgorithm ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "SFLA (N=30, memeplex=5, q=5, iterMeme=10)"^^xsd:string .

mexo:spea2-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-spea2001-001,
        mexo:p-spea2001-002 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:SPEA2 ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "SPEA2 (N=100, archive=100, k=sqrt(N+A))"^^xsd:string .

mexo:ssa-salp-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-ssasalp001-001,
        mexo:p-ssasalp001-002 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:SalpSwarmAlgorithm ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "Salp Swarm Algorithm (SSA) (N=30, c1=2*exp(-(4t/T)^2))"^^xsd:string .

mexo:ssa-sparrow-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-ssasparrow001-001,
        mexo:p-ssasparrow001-002 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:SparrowSearchAlgorithm ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "Sparrow Search Algorithm (SSA) (N=30, PD=0.2, SD=0.1, ST=0.8)"^^xsd:string .

mexo:sso-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-sso001-001,
        mexo:p-sso001-002 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:SocialSpiderOptimization ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "SSO (N=30, PF=0.7)"^^xsd:string .

mexo:swarm-cat-001 a mexo:MetaheuristicAlgorithm ;
    skos:broader mexo:SwarmIntelligenceMetaheuristics ;
    skos:definition "category"^^xsd:string ;
    skos:prefLabel "Swarm intelligence metaheuristics (category)"^^xsd:string .

mexo:tlbo-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-tlbo001-001,
        mexo:p-tlbo001-002 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:TeachingLearningBasedOptimization ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "TLBO (N=30, TF∈{1,2})"^^xsd:string .

mexo:traj-cat-001 a mexo:MetaheuristicAlgorithm ;
    skos:broader mexo:TrajectoryBasedMetaheuristics ;
    skos:definition "category"^^xsd:string ;
    skos:prefLabel "Trajectory-based metaheuristics (category)"^^xsd:string .

mexo:ts-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-ts001-001 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:TabuSearch ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "TS (tenure=7, neighborhood=swap)"^^xsd:string .

mexo:vns-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-vns001-001 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:VariableNeighborhoodSearch ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "VNS (kmax=5, neighborhood=swap)"^^xsd:string .

mexo:woa-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-woa001-001,
        mexo:p-woa001-002 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:WhaleOptimizationAlgorithm ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "WOA (N=30, a=2->0, b=1)"^^xsd:string .

mexo:problem-vrp a mexo:OptimizationProblem ;
    rdfs:label "VRP (CVRP instances)"^^xsd:string ;
    mexo:hasConstraint mexo:c-vrp-capacity ;
    mexo:hasObjectiveFunction mexo:obj-vrp-min ;
    mexo:hasSearchSpace mexo:space-permutation ;
    dct:source "Augerat set"^^xsd:string ;
    skos:note "vehicle routing permutation"^^xsd:string .

mexo:problem-jsp a mexo:OptimizationProblem ;
    rdfs:label "JSP (FT benchmark)"^^xsd:string ;
    mexo:hasObjectiveFunction mexo:obj-jsp-makespan ;
    mexo:hasSearchSpace mexo:space-permutation ;
    dct:source "OR-Library"^^xsd:string ;
    skos:note "job shop permutation"^^xsd:string .

mexo:problem-zdt1 a mexo:OptimizationProblem ;
    rdfs:label "ZDT1 (bi-objective benchmark)"^^xsd:string ;
    mexo:hasObjectiveFunction mexo:obj-zdt1 ;
    dct:source "ZDT benchmark"^^xsd:string ;
    skos:note "Pareto front evaluation"^^xsd:string .

mexo:stop-500 a mexo:StoppingCriterion ;
    rdfs:label "Fixed 500 iterations"^^xsd:string ;
    mexo:maxIterations 500 ;
    skos:note "Medium computational budget"^^xsd:string .

mexo:ct-equality a mexo:ConstraintType ;
    rdfs:label "Equality constraint"^^xsd:string ;
    skos:note "Hard equality constraint"^^xsd:string .

mexo:space-permutation a mexo:SearchSpace ;
    rdfs:label "Permutation space Π_n (all permutations of n items)"^^xsd:string ;
    skos:note "Generic permutation domain: solution is a permutation π of {1..n}. n depends on instance."^^xsd:string .

mexo:stop-1000 a mexo:StoppingCriterion ;
    rdfs:label "Fixed 1000 iterations"^^xsd:string ;
    mexo:maxIterations 1000 ;
    skos:note "Large computational budget"^^xsd:string .

mexo:problem-tsp a mexo:OptimizationProblem ;
    rdfs:label "TSP (Euclidean benchmark)"^^xsd:string ;
    mexo:hasConstraint mexo:c-tsp-degree ;
    mexo:hasObjectiveFunction mexo:obj-tsp-min ;
    mexo:hasSearchSpace mexo:space-permutation ;
    dct:source "TSPLIB"^^xsd:string ;
    skos:note "baseline permutation problem"^^xsd:string .

mexo:problem-continuous a mexo:OptimizationProblem ;
    rdfs:label "Continuous optimization (CEC benchmark)"^^xsd:string ;
    mexo:hasObjectiveFunction mexo:obj-continuous-min ;
    dct:source "CEC benchmark"^^xsd:string ;
    skos:note "single-objective continuous optimization"^^xsd:string .

mexo:stop-feval-10000 a mexo:StoppingCriterion ;
    rdfs:label "Stop after 10000 objective evaluations"^^xsd:string ;
    mexo:maxIterations 10000 ;
    skos:note "Evaluation-based termination criterion"^^xsd:string .

mexo:ptype-real a mexo:ParameterType ;
    rdfs:label "Real number"^^xsd:string ;
    skos:note "Número real (ej. tasa de aprendizaje, inercia PSO)"^^xsd:string .

mexo:type-int a mexo:ParameterType ;
    rdfs:label "Integer"^^xsd:string ;
    skos:note "Número entero (ej. número de iteraciones, tamaño de población)"^^xsd:string .

