@prefix dct: <http://purl.org/dc/terms/> .
@prefix mexo: <https://w3id.org/mexo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mexo:PermutationRepresentation a rdfs:Class ;
    rdfs:label "Permutation Representation"^^xsd:string ;
    rdfs:subClassOf mexo:Representation .

mexo:exp-aco001 a mexo:Experiment ;
    rdfs:label "Ant Colony Optimization (ACO) / Ant System baseline"^^xsd:string ;
    mexo:hasStoppingCriterion mexo:stop-1000 ;
    mexo:numberOfRuns 30 ;
    mexo:randomSeed 42 ;
    mexo:targetsProblem mexo:problem-tsp ;
    mexo:usesAlgorithm mexo:aco-001 ;
    skos:note "discrete/constructive baseline"^^xsd:string .

mexo:aco-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-aco001-001,
        mexo:p-aco001-002,
        mexo:p-aco001-003,
        mexo:p-aco001-004 ;
    mexo:usesRepresentation mexo:PermutationRepresentation ;
    skos:broader mexo:AntColonyOptimization ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "ACO / Ant System (m=50, alpha=1.0, beta=2.0, rho=0.5, Q=1.0)"^^xsd:string .

mexo:c-tsp-degree a mexo:Constraint ;
    rdfs:label "Each city has exactly 2 incident edges"^^xsd:string ;
    mexo:constraintType mexo:ct-equality ;
    mexo:hasProblem mexo:problem-tsp ;
    skos:note "TSP degree constraint"^^xsd:string .

mexo:ct-equality a mexo:ConstraintType ;
    rdfs:label "Equality constraint"^^xsd:string ;
    skos:note "Hard equality constraint"^^xsd:string .

mexo:obj-tsp-min a mexo:ObjectiveFunction ;
    rdfs:label "Minimize total tour length"^^xsd:string ;
    skos:note "Sum of distances between consecutive cities in permutation"^^xsd:string .

mexo:p-aco001-001 a mexo:Parameter ;
    mexo:parameterName "Number of ants"^^xsd:string ;
    mexo:parameterSymbol "m"^^xsd:string ;
    mexo:parameterType mexo:type-int ;
    mexo:parameterValue 50 .

mexo:p-aco001-002 a mexo:Parameter ;
    mexo:parameterName "Pheromone importance"^^xsd:string ;
    mexo:parameterSymbol "alpha"^^xsd:string ;
    mexo:parameterType mexo:ptype-real ;
    mexo:parameterValue 1.0 .

mexo:p-aco001-003 a mexo:Parameter ;
    mexo:parameterName "Heuristic importance"^^xsd:string ;
    mexo:parameterSymbol "beta"^^xsd:string ;
    mexo:parameterType mexo:ptype-real ;
    mexo:parameterValue 2.0 .

mexo:p-aco001-004 a mexo:Parameter ;
    mexo:parameterName "Evaporation rate"^^xsd:string ;
    mexo:parameterSymbol "rho"^^xsd:string ;
    mexo:parameterType mexo:ptype-real ;
    mexo:parameterValue 0.5 .

mexo:space-permutation a mexo:SearchSpace ;
    rdfs:label "Permutation space Π_n (all permutations of n items)"^^xsd:string ;
    skos:note "Generic permutation domain: solution is a permutation π of {1..n}. n depends on instance."^^xsd:string .

mexo:stop-1000 a mexo:StoppingCriterion ;
    rdfs:label "Fixed 1000 iterations"^^xsd:string ;
    mexo:maxIterations 1000 ;
    skos:note "Large computational budget"^^xsd:string .

mexo:type-int a mexo:ParameterType ;
    rdfs:label "Integer"^^xsd:string ;
    skos:note "Número entero (ej. número de iteraciones, tamaño de población)"^^xsd:string .

mexo:problem-tsp a mexo:OptimizationProblem ;
    rdfs:label "TSP (Euclidean benchmark)"^^xsd:string ;
    mexo:hasConstraint mexo:c-tsp-degree ;
    mexo:hasObjectiveFunction mexo:obj-tsp-min ;
    mexo:hasSearchSpace mexo:space-permutation ;
    dct:source "TSPLIB"^^xsd:string ;
    skos:note "baseline permutation problem"^^xsd:string .

mexo:ptype-real a mexo:ParameterType ;
    rdfs:label "Real number"^^xsd:string ;
    skos:note "Número real (ej. tasa de aprendizaje, inercia PSO)"^^xsd:string .

