@prefix dct: <http://purl.org/dc/terms/> .
@prefix mexo: <https://w3id.org/mexo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mexo:exp-ts001 a mexo:Experiment ;
    rdfs:label "Tabu Search (TS) baseline"^^xsd:string ;
    mexo:hasStoppingCriterion mexo:stop-1000 ;
    mexo:numberOfRuns 30 ;
    mexo:randomSeed 42 ;
    mexo:targetsProblem mexo:problem-continuous ;
    mexo:usesAlgorithm mexo:ts-001 ;
    skos:note "trajectory-based baseline"^^xsd:string .

mexo:obj-continuous-min a mexo:ObjectiveFunction ;
    rdfs:label "obj-continuous-min"^^xsd:string ;
    skos:note "obj-continuous-min"^^xsd:string .

mexo:p-ts001-001 a mexo:Parameter ;
    mexo:parameterName "Tabu tenure"^^xsd:string ;
    mexo:parameterSymbol "tenure"^^xsd:string ;
    mexo:parameterType mexo:type-int ;
    mexo:parameterValue 7 .

mexo:problem-continuous a mexo:OptimizationProblem ;
    rdfs:label "Continuous optimization (CEC benchmark)"^^xsd:string ;
    mexo:hasObjectiveFunction mexo:obj-continuous-min ;
    dct:source "CEC benchmark"^^xsd:string ;
    skos:note "single-objective continuous optimization"^^xsd:string .

mexo:stop-1000 a mexo:StoppingCriterion ;
    rdfs:label "Fixed 1000 iterations"^^xsd:string ;
    mexo:maxIterations 1000 ;
    skos:note "Large computational budget"^^xsd:string .

mexo:ts-001 a mexo:MetaheuristicAlgorithm ;
    mexo:hasParameter mexo:p-ts001-001 ;
    mexo:usesRepresentation mexo:RealVectorRepresentation ;
    skos:broader mexo:TabuSearch ;
    skos:definition "baseline"^^xsd:string ;
    skos:prefLabel "TS (tenure=7, neighborhood=swap)"^^xsd:string .

mexo:type-int a mexo:ParameterType ;
    rdfs:label "Integer"^^xsd:string ;
    skos:note "Número entero (ej. número de iteraciones, tamaño de población)"^^xsd:string .

