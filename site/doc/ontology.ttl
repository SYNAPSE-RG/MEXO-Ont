@prefix : <https://w3id.org/mexo/MEXO#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/mexo/MEXO#> .

<https://w3id.org/mexo/MEXO> rdf:type owl:Ontology ;
                              <http://purl.org/dc/terms/created> "2026-07-30"^^xsd:date ;
                              <http://purl.org/dc/terms/description> "OWL ontology for representing metaheuristic algorithms, benchmark problems and instances, experiment configurations, parameters, computational budgets, stopping criteria, and aggregate performance results."@en ;
                              <http://purl.org/dc/terms/hasPart> <https://w3id.org/mexo/MetaheuristicTaxonomy> ;
                              <http://purl.org/dc/terms/modified> "2026-09-01"^^xsd:date ;
                              <http://purl.org/dc/terms/title> "MEXO — Metaheuristic Experiment Ontology"@en ;
                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "mexo" ;
                              <http://purl.org/vocab/vann/preferredNamespaceUri> <https://w3id.org/mexo/> ;
                              owl:versionInfo "5.2.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/hasPart
<http://purl.org/dc/terms/hasPart> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/isPartOf
<http://purl.org/dc/terms/isPartOf> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broader
<http://www.w3.org/2004/02/skos/core#broader> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
<http://www.w3.org/2004/02/skos/core#exactMatch> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
<http://www.w3.org/2004/02/skos/core#inScheme> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#topConceptOf
<http://www.w3.org/2004/02/skos/core#topConceptOf> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/mexo/algorithmUsedByExperiment
<https://w3id.org/mexo/algorithmUsedByExperiment> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                                  rdfs:range <https://w3id.org/mexo/Experiment> ;
                                                  rdfs:comment "Links an algorithm to an experiment that evaluates it."@en ;
                                                  rdfs:label "algorithm used by experiment"@en .


###  https://w3id.org/mexo/budgetOfExperiment
<https://w3id.org/mexo/budgetOfExperiment> rdf:type owl:ObjectProperty ;
                                           owl:inverseOf <https://w3id.org/mexo/hasBudget> ;
                                           rdfs:domain <https://w3id.org/mexo/ComputationalBudget> ;
                                           rdfs:range <https://w3id.org/mexo/Experiment> ;
                                           rdfs:comment "Links a computational budget to the experiment constrained by it."@en ;
                                           rdfs:label "budget of experiment"@en .


###  https://w3id.org/mexo/characteristicOfProblem
<https://w3id.org/mexo/characteristicOfProblem> rdf:type owl:ObjectProperty ;
                                                owl:inverseOf <https://w3id.org/mexo/hasCharacteristic> ;
                                                rdfs:domain <https://w3id.org/mexo/ProblemCharacteristic> ;
                                                rdfs:range <https://w3id.org/mexo/OptimizationProblem> ;
                                                rdfs:comment "Links a controlled characteristic to an optimization problem it describes."@en ;
                                                rdfs:label "characteristic of problem"@en .


###  https://w3id.org/mexo/configurationUsedByExperiment
<https://w3id.org/mexo/configurationUsedByExperiment> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <https://w3id.org/mexo/AlgorithmConfiguration> ;
                                                      rdfs:range <https://w3id.org/mexo/Experiment> ;
                                                      rdfs:comment "Links an algorithm configuration to an experiment that uses it."@en ;
                                                      rdfs:label "configuration used by experiment"@en .


###  https://w3id.org/mexo/configuredBy
<https://w3id.org/mexo/configuredBy> rdf:type owl:ObjectProperty ;
                                     owl:inverseOf <https://w3id.org/mexo/configuresAlgorithm> ;
                                     rdfs:domain <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                     rdfs:range <https://w3id.org/mexo/AlgorithmConfiguration> ;
                                     rdfs:comment "Links an algorithm to a configuration that configures it."@en ;
                                     rdfs:label "configured by"@en .


###  https://w3id.org/mexo/configuresAlgorithm
<https://w3id.org/mexo/configuresAlgorithm> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://w3id.org/mexo/AlgorithmConfiguration> ;
                                            rdfs:range <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                            rdfs:comment "Links an algorithm configuration to the algorithm it configures."@en ;
                                            rdfs:label "configures algorithm"@en .


###  https://w3id.org/mexo/constraintTypeOf
<https://w3id.org/mexo/constraintTypeOf> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/mexo/ConstraintType> ;
                                         rdfs:range <https://w3id.org/mexo/Constraint> ;
                                         rdfs:comment "Links a constraint type to a constraint classified by that type."@en ;
                                         rdfs:label "constraint type of"@en .


###  https://w3id.org/mexo/forParameter
<https://w3id.org/mexo/forParameter> rdf:type owl:ObjectProperty ;
                                     owl:inverseOf <https://w3id.org/mexo/hasSetting> ;
                                     rdfs:domain <https://w3id.org/mexo/ParameterSetting> ;
                                     rdfs:range <https://w3id.org/mexo/ParameterDefinition> ;
                                     rdfs:comment "Links a parameter setting to the parameter definition it instantiates."@en ;
                                     rdfs:label "for parameter"@en .


###  https://w3id.org/mexo/hasBudget
<https://w3id.org/mexo/hasBudget> rdf:type owl:ObjectProperty ;
                                  rdfs:domain <https://w3id.org/mexo/Experiment> ;
                                  rdfs:range <https://w3id.org/mexo/ComputationalBudget> ;
                                  rdfs:comment "Associates an experiment with its computational resource budget."@en ;
                                  rdfs:label "has computational budget"@en .


###  https://w3id.org/mexo/hasCharacteristic
<https://w3id.org/mexo/hasCharacteristic> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://w3id.org/mexo/OptimizationProblem> ;
                                          rdfs:range <https://w3id.org/mexo/ProblemCharacteristic> ;
                                          rdfs:comment "Associates an optimization problem with a controlled characteristic."@en ;
                                          rdfs:label "has problem characteristic"@en .


###  https://w3id.org/mexo/hasConstraint
<https://w3id.org/mexo/hasConstraint> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <https://w3id.org/mexo/hasProblem> ;
                                      rdfs:domain <https://w3id.org/mexo/OptimizationProblem> ;
                                      rdfs:range <https://w3id.org/mexo/Constraint> ;
                                      rdfs:comment "Associates a problem with a constraint."@en ;
                                      rdfs:label "has constraint"@en .


###  https://w3id.org/mexo/hasConstraintType
<https://w3id.org/mexo/hasConstraintType> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <https://w3id.org/mexo/constraintTypeOf> ;
                                          rdfs:domain <https://w3id.org/mexo/Constraint> ;
                                          rdfs:range <https://w3id.org/mexo/ConstraintType> ;
                                          rdfs:comment "Associates a constraint with its type."@en ;
                                          rdfs:label "has constraint type"@en .


###  https://w3id.org/mexo/hasObjectiveFunction
<https://w3id.org/mexo/hasObjectiveFunction> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://w3id.org/mexo/OptimizationProblem> ;
                                             rdfs:range <https://w3id.org/mexo/ObjectiveFunction> ;
                                             rdfs:comment "Associates a problem with its objective function."@en ;
                                             rdfs:label "has objective function"@en .


###  https://w3id.org/mexo/hasParameterDefinition
<https://w3id.org/mexo/hasParameterDefinition> rdf:type owl:ObjectProperty ;
                                               owl:inverseOf <https://w3id.org/mexo/parameterDefinitionOfAlgorithm> ;
                                               rdfs:domain <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                               rdfs:range <https://w3id.org/mexo/ParameterDefinition> ;
                                               rdfs:comment "Links an algorithm to a reusable parameter definition."@en ;
                                               rdfs:label "has parameter definition"@en .


###  https://w3id.org/mexo/hasParameterSetting
<https://w3id.org/mexo/hasParameterSetting> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://w3id.org/mexo/AlgorithmConfiguration> ;
                                            rdfs:range <https://w3id.org/mexo/ParameterSetting> ;
                                            rdfs:comment "Links a configuration to a concrete parameter setting."@en ;
                                            rdfs:label "has parameter setting"@en .


###  https://w3id.org/mexo/hasProblem
<https://w3id.org/mexo/hasProblem> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <https://w3id.org/mexo/Constraint> ;
                                   rdfs:range <https://w3id.org/mexo/OptimizationProblem> ;
                                   rdfs:comment "Links a constraint to the problem it constrains."@en ;
                                   rdfs:label "has problem"@en .


###  https://w3id.org/mexo/hasProblemInstance
<https://w3id.org/mexo/hasProblemInstance> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/mexo/OptimizationProblem> ;
                                           rdfs:range <https://w3id.org/mexo/ProblemInstance> ;
                                           rdfs:comment "Links a general optimization problem to one of its concrete instances."@en ;
                                           rdfs:label "has problem instance"@en .


###  https://w3id.org/mexo/hasResult
<https://w3id.org/mexo/hasResult> rdf:type owl:ObjectProperty ;
                                  rdfs:domain <https://w3id.org/mexo/Experiment> ;
                                  rdfs:range <https://w3id.org/mexo/PerformanceResult> ;
                                  rdfs:comment "Associates an experiment with an aggregate or run-level performance result."@en ;
                                  rdfs:label "has result"@en .


###  https://w3id.org/mexo/hasRun
<https://w3id.org/mexo/hasRun> rdf:type owl:ObjectProperty ;
                               owl:inverseOf <https://w3id.org/mexo/runOfExperiment> ;
                               rdfs:domain <https://w3id.org/mexo/Experiment> ;
                               rdfs:range <https://w3id.org/mexo/Run> ;
                               rdfs:comment "Links an experiment to one of its executions."@en ;
                               rdfs:label "has run"@en .


###  https://w3id.org/mexo/hasSearchSpace
<https://w3id.org/mexo/hasSearchSpace> rdf:type owl:ObjectProperty ;
                                       owl:inverseOf <https://w3id.org/mexo/searchSpaceOfProblem> ;
                                       rdfs:domain <https://w3id.org/mexo/OptimizationProblem> ;
                                       rdfs:range <https://w3id.org/mexo/SearchSpace> ;
                                       rdfs:comment "Associates a problem with its search space."@en ;
                                       rdfs:label "has search space"@en .


###  https://w3id.org/mexo/hasSetting
<https://w3id.org/mexo/hasSetting> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <https://w3id.org/mexo/ParameterDefinition> ;
                                   rdfs:range <https://w3id.org/mexo/ParameterSetting> ;
                                   rdfs:comment "Links a parameter definition to a parameter setting that instantiates it."@en ;
                                   rdfs:label "has setting"@en .


###  https://w3id.org/mexo/hasStoppingCriterion
<https://w3id.org/mexo/hasStoppingCriterion> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://w3id.org/mexo/Experiment> ;
                                             rdfs:range <https://w3id.org/mexo/StoppingCriterion> ;
                                             rdfs:comment "Associates an experiment with a stopping criterion."@en ;
                                             rdfs:label "has stopping criterion"@en .


###  https://w3id.org/mexo/hasStudySource
<https://w3id.org/mexo/hasStudySource> rdf:type owl:ObjectProperty .


###  https://w3id.org/mexo/instanceOfProblem
<https://w3id.org/mexo/instanceOfProblem> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <https://w3id.org/mexo/hasProblemInstance> ;
                                          rdfs:domain <https://w3id.org/mexo/ProblemInstance> ;
                                          rdfs:range <https://w3id.org/mexo/OptimizationProblem> ;
                                          rdfs:comment "Links a concrete problem instance to its general benchmark problem definition."@en ;
                                          rdfs:label "instance of problem"@en .


###  https://w3id.org/mexo/instanceTargetedByExperiment
<https://w3id.org/mexo/instanceTargetedByExperiment> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <https://w3id.org/mexo/ProblemInstance> ;
                                                     rdfs:range <https://w3id.org/mexo/Experiment> ;
                                                     rdfs:comment "Links a problem instance to an experiment that evaluates it."@en ;
                                                     rdfs:label "instance targeted by experiment"@en .


###  https://w3id.org/mexo/objectiveFunctionOfProblem
<https://w3id.org/mexo/objectiveFunctionOfProblem> rdf:type owl:ObjectProperty ;
                                                   owl:inverseOf <https://w3id.org/mexo/hasObjectiveFunction> ;
                                                   rdfs:domain <https://w3id.org/mexo/ObjectiveFunction> ;
                                                   rdfs:range <https://w3id.org/mexo/OptimizationProblem> ;
                                                   rdfs:comment "Links an objective function to an optimization problem it defines."@en ;
                                                   rdfs:label "objective function of problem"@en .


###  https://w3id.org/mexo/parameterDefinitionOfAlgorithm
<https://w3id.org/mexo/parameterDefinitionOfAlgorithm> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <https://w3id.org/mexo/ParameterDefinition> ;
                                                       rdfs:range <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                                       rdfs:comment "Links a reusable parameter definition to the algorithm that declares it."@en ;
                                                       rdfs:label "parameter definition of algorithm"@en .


###  https://w3id.org/mexo/parameterSettingOfConfiguration
<https://w3id.org/mexo/parameterSettingOfConfiguration> rdf:type owl:ObjectProperty ;
                                                        owl:inverseOf <https://w3id.org/mexo/hasParameterSetting> ;
                                                        rdfs:domain <https://w3id.org/mexo/ParameterSetting> ;
                                                        rdfs:range <https://w3id.org/mexo/AlgorithmConfiguration> ;
                                                        rdfs:comment "Links a parameter setting to the algorithm configuration that contains it."@en ;
                                                        rdfs:label "parameter setting of configuration"@en .


###  https://w3id.org/mexo/parameterType
<https://w3id.org/mexo/parameterType> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <https://w3id.org/mexo/typeOfParameterDefinition> ;
                                      rdfs:domain <https://w3id.org/mexo/ParameterDefinition> ;
                                      rdfs:range <https://w3id.org/mexo/ParameterType> ;
                                      rdfs:comment "Associates a parameter definition with its type."@en ;
                                      rdfs:label "parameter type"@en .


###  https://w3id.org/mexo/problemTargetedByExperiment
<https://w3id.org/mexo/problemTargetedByExperiment> rdf:type owl:ObjectProperty ;
                                                    owl:inverseOf <https://w3id.org/mexo/targetsProblem> ;
                                                    rdfs:domain <https://w3id.org/mexo/OptimizationProblem> ;
                                                    rdfs:range <https://w3id.org/mexo/Experiment> ;
                                                    rdfs:comment "Links an optimization problem to an experiment that addresses it."@en ;
                                                    rdfs:label "problem targeted by experiment"@en .


###  https://w3id.org/mexo/producedByRun
<https://w3id.org/mexo/producedByRun> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <https://w3id.org/mexo/producesResult> ;
                                      rdfs:domain <https://w3id.org/mexo/Result> ;
                                      rdfs:range <https://w3id.org/mexo/Run> ;
                                      rdfs:comment "Links a result to the run that produced it."@en ;
                                      rdfs:label "produced by run"@en .


###  https://w3id.org/mexo/producesResult
<https://w3id.org/mexo/producesResult> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/mexo/Run> ;
                                       rdfs:range <https://w3id.org/mexo/Result> ;
                                       rdfs:comment "Links a run to a result it produced."@en ;
                                       rdfs:label "produces result"@en .


###  https://w3id.org/mexo/representationUsedByAlgorithm
<https://w3id.org/mexo/representationUsedByAlgorithm> rdf:type owl:ObjectProperty ;
                                                      owl:inverseOf <https://w3id.org/mexo/usesRepresentation> ;
                                                      rdfs:domain <https://w3id.org/mexo/Representation> ;
                                                      rdfs:range <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                                      rdfs:comment "Links a representation to an algorithm that operates on it."@en ;
                                                      rdfs:label "representation used by algorithm"@en .


###  https://w3id.org/mexo/resultOfExperiment
<https://w3id.org/mexo/resultOfExperiment> rdf:type owl:ObjectProperty ;
                                           owl:inverseOf <https://w3id.org/mexo/hasResult> ;
                                           rdfs:domain <https://w3id.org/mexo/PerformanceResult> ;
                                           rdfs:range <https://w3id.org/mexo/Experiment> ;
                                           rdfs:comment "Links a performance result to the experiment that produced or aggregated it."@en ;
                                           rdfs:label "result of experiment"@en .


###  https://w3id.org/mexo/runOfExperiment
<https://w3id.org/mexo/runOfExperiment> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://w3id.org/mexo/Run> ;
                                        rdfs:range <https://w3id.org/mexo/Experiment> ;
                                        rdfs:comment "Links a run to the experiment of which it is an execution."@en ;
                                        rdfs:label "run of experiment"@en .


###  https://w3id.org/mexo/searchSpaceOfProblem
<https://w3id.org/mexo/searchSpaceOfProblem> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://w3id.org/mexo/SearchSpace> ;
                                             rdfs:range <https://w3id.org/mexo/OptimizationProblem> ;
                                             rdfs:comment "Links a search space to an optimization problem defined over it."@en ;
                                             rdfs:label "search space of problem"@en .


###  https://w3id.org/mexo/sourceOfAlgorithm
<https://w3id.org/mexo/sourceOfAlgorithm> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <https://w3id.org/mexo/hasStudySource> ;
                                          rdfs:domain <https://w3id.org/mexo/SourceStudy> ;
                                          rdfs:range <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                          rdfs:comment "Links a source study to an algorithm described or reported by it."@en ;
                                          rdfs:label "source of algorithm"@en .


###  https://w3id.org/mexo/stoppingCriterionOfExperiment
<https://w3id.org/mexo/stoppingCriterionOfExperiment> rdf:type owl:ObjectProperty ;
                                                      owl:inverseOf <https://w3id.org/mexo/hasStoppingCriterion> ;
                                                      rdfs:domain <https://w3id.org/mexo/StoppingCriterion> ;
                                                      rdfs:range <https://w3id.org/mexo/Experiment> ;
                                                      rdfs:comment "Links a stopping criterion to the experiment governed by it."@en ;
                                                      rdfs:label "stopping criterion of experiment"@en .


###  https://w3id.org/mexo/targetsInstance
<https://w3id.org/mexo/targetsInstance> rdf:type owl:ObjectProperty ;
                                        owl:inverseOf <https://w3id.org/mexo/instanceTargetedByExperiment> ;
                                        rdfs:domain <https://w3id.org/mexo/Experiment> ;
                                        rdfs:range <https://w3id.org/mexo/ProblemInstance> ;
                                        rdfs:comment "Links an experiment to the concrete problem instance evaluated."@en ;
                                        rdfs:label "targets problem instance"@en .


###  https://w3id.org/mexo/targetsProblem
<https://w3id.org/mexo/targetsProblem> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <https://w3id.org/mexo/Experiment> ;
                                       rdfs:range <https://w3id.org/mexo/OptimizationProblem> ;
                                       rdfs:comment "Links an experiment to the optimization problem it addresses."@en ;
                                       rdfs:label "targets problem"@en .


###  https://w3id.org/mexo/typeOfParameterDefinition
<https://w3id.org/mexo/typeOfParameterDefinition> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://w3id.org/mexo/ParameterType> ;
                                                  rdfs:range <https://w3id.org/mexo/ParameterDefinition> ;
                                                  rdfs:comment "Links a parameter type to a parameter definition classified by that type."@en ;
                                                  rdfs:label "type of parameter definition"@en .


###  https://w3id.org/mexo/usesAlgorithm
<https://w3id.org/mexo/usesAlgorithm> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <https://w3id.org/mexo/algorithmUsedByExperiment> ;
                                      rdfs:domain <https://w3id.org/mexo/Experiment> ;
                                      rdfs:range <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                      rdfs:comment "Directly links an experiment to the algorithm being evaluated."@en ;
                                      rdfs:label "uses algorithm"@en .


###  https://w3id.org/mexo/usesConfiguration
<https://w3id.org/mexo/usesConfiguration> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <https://w3id.org/mexo/configurationUsedByExperiment> ;
                                          rdfs:domain <https://w3id.org/mexo/Experiment> ;
                                          rdfs:range <https://w3id.org/mexo/AlgorithmConfiguration> ;
                                          rdfs:comment "Links an experiment to the concrete algorithm configuration it uses."@en ;
                                          rdfs:label "uses configuration"@en .


###  https://w3id.org/mexo/usesRepresentation
<https://w3id.org/mexo/usesRepresentation> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                           rdfs:range <https://w3id.org/mexo/Representation> ;
                                           rdfs:comment "Declares the representation on which an algorithm operates."@en ;
                                           rdfs:label "uses representation"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/mexo/bestFitness
<https://w3id.org/mexo/bestFitness> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/mexo/PerformanceResult> ;
                                    rdfs:range xsd:decimal ;
                                    rdfs:comment "Best objective value reported for the result."@en ;
                                    rdfs:label "best fitness"@en .


###  https://w3id.org/mexo/dimension
