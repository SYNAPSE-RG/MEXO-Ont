                                             rdfs:range xsd:decimal ;
                                             rdfs:comment "Standard error of the reported mean fitness."@en ;
                                             rdfs:label "fitness standard error"@en .


###  https://w3id.org/mexo/hasConstraintName
<https://w3id.org/mexo/hasConstraintName> rdf:type owl:DatatypeProperty ;
