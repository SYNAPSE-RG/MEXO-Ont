#################################################################
#    Classes
#################################################################

###  http://purl.org/dc/terms/BibliographicResource
<http://purl.org/dc/terms/BibliographicResource> rdf:type owl:Class ;
                                                 rdfs:comment "A book, article, document, or other resource that may be identified through a bibliographic reference."@en ;
                                                 rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
                                                 rdfs:label "Bibliographic resource"@en .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class ;
                                              rdfs:comment "A unit of thought represented in a knowledge organization system."@en ;
                                              rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                              rdfs:label "Concept"@en .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  https://w3id.org/mexo/AlgorithmConfiguration
<https://w3id.org/mexo/AlgorithmConfiguration> rdf:type owl:Class ;
                                               rdfs:comment "A concrete configuration of an algorithm used by an experiment."@en ;
                                               rdfs:label "Algorithm configuration"@en .


###  https://w3id.org/mexo/ComputationalBudget
<https://w3id.org/mexo/ComputationalBudget> rdf:type owl:Class ;
                                            rdfs:comment "A limit on computational resources available to an experiment."@en ;
                                            rdfs:label "Computational budget"@en .


###  https://w3id.org/mexo/Constraint
<https://w3id.org/mexo/Constraint> rdf:type owl:Class ;
                                   rdfs:comment "A condition restricting feasible solutions."@en ;
                                   rdfs:label "Constraint"@en .


###  https://w3id.org/mexo/ConstraintType
<https://w3id.org/mexo/ConstraintType> rdf:type owl:Class ;
                                       rdfs:comment "A controlled category of optimization constraint."@en ;
                                       rdfs:label "Constraint type"@en .


###  https://w3id.org/mexo/Experiment
<https://w3id.org/mexo/Experiment> rdf:type owl:Class ;
                                   rdfs:comment "A planned execution of an algorithm on a problem under a defined configuration."@en ;
                                   rdfs:label "Experiment"@en .


###  https://w3id.org/mexo/MetaheuristicAlgorithm
<https://w3id.org/mexo/MetaheuristicAlgorithm> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                                               rdfs:comment "A reusable metaheuristic method represented as a SKOS concept."@en ;
                                               rdfs:label "Metaheuristic algorithm"@en .


###  https://w3id.org/mexo/MetaheuristicFamily
<https://w3id.org/mexo/MetaheuristicFamily> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                                            rdfs:comment "A SKOS concept used to group related metaheuristic algorithms."@en ;
                                            rdfs:label "Metaheuristic family"@en .


###  https://w3id.org/mexo/NumericalBenchmarkFunction
<https://w3id.org/mexo/NumericalBenchmarkFunction> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://w3id.org/mexo/OptimizationProblem> ;
                                                   owl:disjointWith <https://w3id.org/mexo/ProblemInstance> ;
                                                   rdfs:comment "A numerical optimization benchmark function used to compare algorithms."@en ;
                                                   rdfs:label "Numerical benchmark function"@en .


###  https://w3id.org/mexo/ObjectiveFunction
<https://w3id.org/mexo/ObjectiveFunction> rdf:type owl:Class ;
                                          rdfs:comment "A function that maps candidate solutions to objective values."@en ;
                                          rdfs:label "Objective function"@en .


###  https://w3id.org/mexo/OptimizationProblem
<https://w3id.org/mexo/OptimizationProblem> rdf:type owl:Class ;
                                            rdfs:comment "An optimization task defined by an objective function and a search space."@en ;
                                            rdfs:label "Optimization problem"@en .


###  https://w3id.org/mexo/Parameter
<https://w3id.org/mexo/Parameter> rdf:type owl:Class ;
                                  rdfs:comment "General parameter concept retained as a superclass for compatibility."@en ;
                                  rdfs:label "Parameter"@en .


###  https://w3id.org/mexo/ParameterDefinition
<https://w3id.org/mexo/ParameterDefinition> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/mexo/Parameter> ;
                                            owl:disjointWith <https://w3id.org/mexo/ParameterSetting> ;
                                            rdfs:comment "A reusable definition of an algorithm parameter."@en ;
                                            rdfs:label "Parameter definition"@en .


###  https://w3id.org/mexo/ParameterSetting
<https://w3id.org/mexo/ParameterSetting> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/mexo/Parameter> ;
                                         rdfs:comment "A parameter value assigned within a specific algorithm configuration."@en ;
                                         rdfs:label "Parameter setting"@en .


###  https://w3id.org/mexo/ParameterType
<https://w3id.org/mexo/ParameterType> rdf:type owl:Class ;
                                      rdfs:comment "A controlled type used to characterize a parameter definition."@en ;
                                      rdfs:label "Parameter type"@en .


###  https://w3id.org/mexo/PerformanceResult
<https://w3id.org/mexo/PerformanceResult> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/mexo/Result> ;
                                          rdfs:comment "An aggregate or run-level result reporting optimization performance measurements."@en ;
                                          rdfs:label "Performance result"@en .


###  https://w3id.org/mexo/ProblemCharacteristic
<https://w3id.org/mexo/ProblemCharacteristic> rdf:type owl:Class ;
                                              rdfs:comment "A controlled characteristic used to describe an optimization problem, such as modality or separability."@en ;
                                              rdfs:label "Problem characteristic"@en .


###  https://w3id.org/mexo/ProblemInstance
<https://w3id.org/mexo/ProblemInstance> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/mexo/OptimizationProblem> ;
                                        rdfs:comment "A concrete dimensional or otherwise parameterized instance of an optimization problem."@en ;
                                        rdfs:label "Problem instance"@en .


###  https://w3id.org/mexo/Representation
<https://w3id.org/mexo/Representation> rdf:type owl:Class ;
                                       rdfs:comment "A representation used to encode candidate solutions."@en ;
                                       rdfs:label "Representation"@en .


###  https://w3id.org/mexo/Result
<https://w3id.org/mexo/Result> rdf:type owl:Class ;
                               rdfs:comment "An output produced by an experiment or run."@en ;
                               rdfs:label "Result"@en .


###  https://w3id.org/mexo/Run
<https://w3id.org/mexo/Run> rdf:type owl:Class ;
                            rdfs:comment "One execution within an experiment."@en ;
                            rdfs:label "Run"@en .


###  https://w3id.org/mexo/SearchSpace
<https://w3id.org/mexo/SearchSpace> rdf:type owl:Class ;
                                    rdfs:comment "The domain of candidate solutions."@en ;
                                    rdfs:label "Search space"@en .


###  https://w3id.org/mexo/SourceStudy
<https://w3id.org/mexo/SourceStudy> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://purl.org/dc/terms/BibliographicResource> ;
                                    rdfs:comment "A bibliographic source from which experiment configurations, benchmark definitions, or reported results are extracted."@en ;
                                    rdfs:label "Source study"@en .


###  https://w3id.org/mexo/StoppingCriterion
<https://w3id.org/mexo/StoppingCriterion> rdf:type owl:Class ;
                                          rdfs:comment "A rule determining when an experiment should stop."@en ;
                                          rdfs:label "Stopping criterion"@en .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/mexo/AntColonyOptimization
<https://w3id.org/mexo/AntColonyOptimization> rdf:type owl:NamedIndividual ,
                                                       <http://www.w3.org/2004/02/skos/core#Concept> ,
                                                       <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                              <http://purl.org/dc/terms/issued> "1996"^^xsd:gYear ;
                                              <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/mexo/SwarmIntelligence> ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "Stochastic constructive search inspired by pheromone-based foraging; solutions are built probabilistically and reinforced by pheromone updates. Reference: Dorigo, M., Maniezzo, V., & Colorni, A. (1996). The ant system: Optimization by a colony of cooperating agents. IEEE Transactions on Systems, Man, and Cybernetics—Part B, 26(1), 29–41."@en ;
                                              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://dbpedia.org/resource/Ant_colony_optimization_algorithms> ;
                                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/mexo/MetaheuristicTaxonomy> ;
                                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Ant Colony Optimization (ACO) / Ant System"@en .


###  https://w3id.org/mexo/AntLionOptimizer
<https://w3id.org/mexo/AntLionOptimizer> rdf:type owl:NamedIndividual ,
                                                  <http://www.w3.org/2004/02/skos/core#Concept> ,
                                                  <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                         <http://purl.org/dc/terms/issued> "2015"^^xsd:gYear ;
                                         <http://purl.org/dc/terms/source> <https://doi.org/10.1016/j.advengsoft.2015.01.010> ;
                                         <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/mexo/SwarmIntelligence> ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "Swarm algorithm inspired by antlion hunting; ants perform random walks influenced by antlions (elite solutions). Reference: Mirjalili, S. (2015). The ant lion optimizer. Advances in Engineering Software, 83, 80–98. https://doi.org/10.1016/j.advengsoft.2015.01.010"@en ;
                                         <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/mexo/MetaheuristicTaxonomy> ;
                                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Ant Lion Optimizer (ALO)"@en .


###  https://w3id.org/mexo/ArtificialBeeColony
<https://w3id.org/mexo/ArtificialBeeColony> rdf:type owl:NamedIndividual ,
                                                     <http://www.w3.org/2004/02/skos/core#Concept> ,
                                                     <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                            <http://purl.org/dc/terms/issued> "2007"^^xsd:gYear ;
                                            <http://purl.org/dc/terms/source> <https://doi.org/10.1007/s10898-007-9149-x> ;
                                            <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/mexo/SwarmIntelligence> ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Bee-foraging inspired algorithm with employed, onlooker, and scout bees exploring and exploiting food sources (candidate solutions). Reference: Karaboga, D., & Basturk, B. (2007). A powerful and efficient algorithm for numerical function optimization: artificial bee colony (ABC) algorithm. Journal of Global Optimization, 39, 459–471. https://doi.org/10.1007/s10898-007-9149-x"@en ;
                                            <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/mexo/MetaheuristicTaxonomy> ;
                                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Artificial Bee Colony (ABC)"@en .


###  https://w3id.org/mexo/ArtificialFishSwarmAlgorithm
<https://w3id.org/mexo/ArtificialFishSwarmAlgorithm> rdf:type owl:NamedIndividual ,
                                                              <http://www.w3.org/2004/02/skos/core#Concept> ,
                                                              <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                                     <http://purl.org/dc/terms/issued> "2002"^^xsd:gYear ;
                                                     <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/mexo/SwarmIntelligence> ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "Swarm intelligence method inspired by fish behaviors such as prey, swarm, follow, and random actions to explore the search space. Reference: Li, X.-L., Shao, Z.-J., & Qian, J.-X. (2002). An optimizing method based on autonomous animats: Fish-swarm algorithm. Systems Engineering—Theory & Practice, 22(11), 32–38."@en ;
                                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/mexo/MetaheuristicTaxonomy> ;
                                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Artificial Fish Swarm Algorithm (AFSA)"@en .


###  https://w3id.org/mexo/ArtificialImmuneNetwork
<https://w3id.org/mexo/ArtificialImmuneNetwork> rdf:type owl:NamedIndividual ,
                                                         <http://www.w3.org/2004/02/skos/core#Concept> ,
                                                         <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                                <http://purl.org/dc/terms/issued> "2002"^^xsd:gYear ;
                                                <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/mexo/BioInspired> ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "Artificial immune network approach where antibodies are cloned, mutated, and suppressed to maintain diversity while optimizing. Reference: de Castro, L. N., & Von Zuben, F. J. (2002). aiNet: An artificial immune network for data analysis. In Data Mining: A Heuristic Approach (pp. 231–259). Idea Group Publishing."@en ;
                                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/mexo/MetaheuristicTaxonomy> ;
                                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Artificial Immune Network (opt-aiNet)"@en .


###  https://w3id.org/mexo/BacterialForagingOptimization
<https://w3id.org/mexo/BacterialForagingOptimization> rdf:type owl:NamedIndividual ,
                                                               <http://www.w3.org/2004/02/skos/core#Concept> ,
                                                               <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
                                                      <http://purl.org/dc/terms/issued> "2002"^^xsd:gYear ;
                                                      <http://purl.org/dc/terms/source> <https://doi.org/10.1109/mcs.2002.1004010> ;
                                                      <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/mexo/BioInspired> ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "Optimization inspired by bacterial chemotaxis, reproduction, and elimination–dispersal behaviors. Reference: Passino, K. M. (2002). Biomimicry of bacterial foraging for distributed optimization and control. IEEE Control Systems Magazine, 22(3), 52–67. https://doi.org/10.1109/MCS.2002.1004010"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/mexo/MetaheuristicTaxonomy> ;
                                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Bacterial Foraging Optimization (BFOA)"@en .


###  https://w3id.org/mexo/BatAlgorithm
<https://w3id.org/mexo/BatAlgorithm> rdf:type owl:NamedIndividual ,
                                              <http://www.w3.org/2004/02/skos/core#Concept> ,
                                              <https://w3id.org/mexo/MetaheuristicAlgorithm> ;
