                                  rdfs:range xsd:decimal ;
                                  rdfs:comment "Numerical tolerance used by a stopping criterion."@en ;
                                  rdfs:label "stopping tolerance"@en .


###  https://w3id.org/mexo/worstFitness
<https://w3id.org/mexo/worstFitness> rdf:type owl:DatatypeProperty ;
