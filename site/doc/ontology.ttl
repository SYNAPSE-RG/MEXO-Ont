                                  rdfs:domain <https://w3id.org/mexo/ProblemInstance> ;
                                  rdfs:range xsd:integer ;
                                  rdfs:comment "Number of decision variables in a concrete problem instance."@en ;
                                  rdfs:label "problem dimension"@en .


