                                          rdfs:comment "Human-readable name of a constraint."@en ;
                                          rdfs:label "constraint name"@en .


###  https://w3id.org/mexo/knownOptimum
<https://w3id.org/mexo/knownOptimum> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/mexo/OptimizationProblem> ;
                                     rdfs:range xsd:decimal ;
                                     rdfs:comment "Known optimum objective value for a problem or problem instance."@en ;
                                     rdfs:label "known optimum"@en .


###  https://w3id.org/mexo/maxEvaluations
<https://w3id.org/mexo/maxEvaluations> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain [ rdf:type owl:Class ;
                                                     owl:unionOf ( <https://w3id.org/mexo/ComputationalBudget>
                                                                   <https://w3id.org/mexo/StoppingCriterion>
                                                                 )
                                                   ] ;
                                       rdfs:range xsd:integer ;
                                       rdfs:comment "Maximum number of objective-function evaluations allowed."@en ;
                                       rdfs:label "maximum evaluations"@en .


###  https://w3id.org/mexo/maxIterations
<https://w3id.org/mexo/maxIterations> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain [ rdf:type owl:Class ;
                                                    owl:unionOf ( <https://w3id.org/mexo/ComputationalBudget>
                                                                  <https://w3id.org/mexo/StoppingCriterion>
                                                                )
                                                  ] ;
                                      rdfs:range xsd:integer ;
                                      rdfs:comment "Maximum number of iterations allowed."@en ;
                                      rdfs:label "maximum iterations"@en .


###  https://w3id.org/mexo/meanFitness
<https://w3id.org/mexo/meanFitness> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/mexo/PerformanceResult> ;
                                    rdfs:range xsd:decimal ;
                                    rdfs:comment "Mean objective value reported across runs."@en ;
                                    rdfs:label "mean fitness"@en .


###  https://w3id.org/mexo/numberOfRuns
<https://w3id.org/mexo/numberOfRuns> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <https://w3id.org/mexo/Experiment> ;
                                     rdfs:range xsd:integer ;
                                     rdfs:comment "Number of independent runs planned for an experiment."@en ;
                                     rdfs:label "number of runs"@en .


###  https://w3id.org/mexo/parameterName
<https://w3id.org/mexo/parameterName> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <https://w3id.org/mexo/ParameterDefinition> ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "Human-readable name of a parameter definition."@en ;
                                      rdfs:label "parameter name"@en .


###  https://w3id.org/mexo/parameterSymbol
<https://w3id.org/mexo/parameterSymbol> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain <https://w3id.org/mexo/ParameterDefinition> ;
                                        rdfs:range xsd:string ;
                                        rdfs:comment "Short symbol identifying a parameter definition."@en ;
                                        rdfs:label "parameter symbol"@en .


###  https://w3id.org/mexo/parameterValue
<https://w3id.org/mexo/parameterValue> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <https://w3id.org/mexo/ParameterSetting> ;
                                       rdfs:range rdfs:Literal ;
                                       rdfs:comment "Concrete value assigned by a parameter setting."@en ;
                                       rdfs:label "parameter value"@en .


###  https://w3id.org/mexo/randomSeed
<https://w3id.org/mexo/randomSeed> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/mexo/Experiment> ;
                                   rdfs:range xsd:integer ;
                                   rdfs:comment "Seed used to initialize random number generation."@en ;
                                   rdfs:label "random seed"@en .


###  https://w3id.org/mexo/rank
<https://w3id.org/mexo/rank> rdf:type owl:DatatypeProperty ;
                             rdfs:domain <https://w3id.org/mexo/PerformanceResult> ;
                             rdfs:range xsd:integer ;
                             rdfs:comment "Ordinal rank assigned to the result within its comparison group."@en ;
                             rdfs:label "rank"@en .


###  https://w3id.org/mexo/runtimeLimitSeconds
<https://w3id.org/mexo/runtimeLimitSeconds> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <https://w3id.org/mexo/ComputationalBudget> ;
                                            rdfs:range xsd:decimal ;
                                            rdfs:comment "Maximum permitted runtime expressed in seconds."@en ;
                                            rdfs:label "runtime limit in seconds"@en .


###  https://w3id.org/mexo/runtimeSeconds
<https://w3id.org/mexo/runtimeSeconds> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <https://w3id.org/mexo/PerformanceResult> ;
                                       rdfs:range xsd:decimal ;
                                       rdfs:comment "Observed runtime expressed in seconds."@en ;
                                       rdfs:label "runtime in seconds"@en .


###  https://w3id.org/mexo/searchRange
<https://w3id.org/mexo/searchRange> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/mexo/OptimizationProblem> ;
                                    rdfs:range xsd:string ;
                                    rdfs:comment "Textual representation of the search bounds reported by the source."@en ;
                                    rdfs:label "search range"@en .


###  https://w3id.org/mexo/sourceFile
<https://w3id.org/mexo/sourceFile> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/mexo/SourceStudy> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "File name of a locally managed source document."@en ;
                                   rdfs:label "source file"@en .


###  https://w3id.org/mexo/sourceTable
<https://w3id.org/mexo/sourceTable> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/mexo/SourceStudy> ;
                                    rdfs:range xsd:string ;
                                    rdfs:comment "Table or section in the source study from which the statement was extracted."@en ;
                                    rdfs:label "source table"@en .


###  https://w3id.org/mexo/successRate
<https://w3id.org/mexo/successRate> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <https://w3id.org/mexo/PerformanceResult> ;
                                    rdfs:range xsd:decimal ;
                                    rdfs:comment "Proportion or percentage of successful runs, as reported by the source."@en ;
                                    rdfs:label "success rate"@en .


###  https://w3id.org/mexo/tolerance
