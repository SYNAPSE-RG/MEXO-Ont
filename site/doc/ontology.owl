    <owl:NamedIndividual rdf:about="https://w3id.org/mexo/VariableNeighborhoodSearch">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/mexo/MetaheuristicAlgorithm"/>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1997</terms:issued>
