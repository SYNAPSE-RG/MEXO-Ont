    <!-- https://w3id.org/mexo/TabuSearch -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mexo/TabuSearch">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/mexo/MetaheuristicAlgorithm"/>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1989</terms:issued>
        <terms:source rdf:resource="https://doi.org/10.1287/ijoc.1.3.190"/>
        <skos:broader rdf:resource="https://w3id.org/mexo/TrajectoryBased"/>
        <skos:definition xml:lang="en">Neighborhood-based search that uses adaptive memory (tabu lists) to avoid cycling and guide exploration. Reference: Glover, F. (1989). Tabu Search—Part I. ORSA Journal on Computing, 1(3), 190–206. https://doi.org/10.1287/ijoc.1.3.190</skos:definition>
        <skos:exactMatch rdf:resource="http://dbpedia.org/resource/Tabu_search"/>
        <skos:inScheme rdf:resource="https://w3id.org/mexo/MetaheuristicTaxonomy"/>
        <skos:prefLabel xml:lang="en">Tabu Search (TS)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mexo/TeachingLearningBasedOptimization -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mexo/TeachingLearningBasedOptimization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/mexo/MetaheuristicAlgorithm"/>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2011</terms:issued>
        <terms:source rdf:resource="https://doi.org/10.1016/j.cad.2010.12.015"/>
        <skos:broader rdf:resource="https://w3id.org/mexo/HumanSocioInspired"/>
        <skos:definition xml:lang="en">Population-based method inspired by teaching–learning in a classroom, with teacher and learner phases. Reference: Rao, R. V., Savsani, V. J., &amp; Vakharia, D. P. (2011). Teaching–learning-based optimization: A novel method for constrained mechanical design optimization problems. Computer-Aided Design, 43(3), 303–315. https://doi.org/10.1016/j.cad.2010.12.015</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/mexo/MetaheuristicTaxonomy"/>
        <skos:prefLabel xml:lang="en">Teaching–Learning-Based Optimization (TLBO)</skos:prefLabel>
    </owl:NamedIndividual>
    


