    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mexo/WhaleOptimizationAlgorithm -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mexo/WhaleOptimizationAlgorithm">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/mexo/MetaheuristicAlgorithm"/>
