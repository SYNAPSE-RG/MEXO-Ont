}, {
  "@id" : "https://w3id.org/mexo/CuckooSearch",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2009"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1109/NABIC.2009.5393690"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/SwarmIntelligence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Metaheuristic based on brood parasitism and Lévy flights, combining global exploration with local exploitation via selection and replacement. Reference: Yang, X.-S., & Deb, S. (2009). Cuckoo search via Lévy flights. In Proceedings of the World Congress on Nature & Biologically Inspired Computing (NaBIC 2009) (pp. 210–214). IEEE. https://doi.org/10.1109/NABIC.2009.5393690"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Cuckoo Search (CS)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/CulturalAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1994"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/EvolutionaryComputation"
  }, {
    "@id" : "https://w3id.org/mexo/HumanSocioInspired"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Evolutionary framework that couples a population space with a belief space capturing acquired knowledge to guide search. Reference: Reynolds, R. G. (1994). An introduction to cultural algorithms. In Proceedings of the Third Annual Conference on Evolutionary Programming (pp. 131–139)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Cultural Algorithm (CA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/DifferentialEvolution",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1997"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1023/A:1008202821328"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/EvolutionaryComputation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Real-valued evolutionary method that perturbs solutions by scaled differences of randomly selected population vectors. Reference: Storn, R., & Price, K. (1997). Differential evolution—A simple and efficient heuristic for global optimization over continuous spaces. Journal of Global Optimization, 11, 341–359. https://doi.org/10.1023/A:1008202821328"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://dbpedia.org/resource/Differential_evolution"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Differential Evolution (DE)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/DragonflyAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2016"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1016/j.advengsoft.2015.11.003"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/SwarmIntelligence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Swarm algorithm inspired by dragonfly static/dynamic swarming behaviors using separation, alignment, cohesion, attraction, and distraction terms. Reference: Mirjalili, S. (2016). Dragonfly algorithm: A new meta-heuristic optimization technique for solving single-objective, discrete, and multi-objective problems. Neural Computing and Applications, 27, 1053–1073. https://doi.org/10.1007/s00521-015-1920-1"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Dragonfly Algorithm (DA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/ElectromagnetismLikeMechanism",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2003"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1023/A:1022452626305"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/PhysicsInspired"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Population heuristic using attraction–repulsion forces between points based on their objective values to guide movement toward optima. Reference: Birbil, Ş. İ., & Fang, S. C. (2003). An electromagnetism-like mechanism for global optimization. Journal of Global Optimization, 25, 263–282. https://doi.org/10.1023/A:1022452626305"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Electromagnetism-like Mechanism (EM)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/EstimationOfDistributionAlgorithms",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1996"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/EvolutionaryComputation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Population-based optimization that replaces crossover/mutation with learning a probabilistic model of promising solutions and sampling from it. Reference: Mühlenbein, H., & Paaß, G. (1996). From recombination of genes to the estimation of distributions I. Binary parameters. In H.-M. Voigt et al. (Eds.), Parallel Problem Solving from Nature—PPSN IV (LNCS 1411, pp. 178–187). Springer."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Estimation of Distribution Algorithms (EDA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/EvolutionStrategies",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1973"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/EvolutionaryComputation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Evolutionary optimization framework emphasizing mutation and self-adaptation of strategy parameters. Reference: Rechenberg, I. (1973). Evolutionsstrategie: Optimierung technischer Systeme nach Prinzipien der biologischen Evolution. Frommann-Holzboog."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Evolution Strategies (ES)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/EvolutionaryComputation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicFamily"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Evolutionary computation metaheuristics"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/EvolutionaryProgramming",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1966"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/EvolutionaryComputation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Early evolutionary approach using mutation and selection over finite-state structures and later continuous representations. Reference: Fogel, L. J., Owens, A. J., & Walsh, M. J. (1966). Artificial Intelligence through Simulated Evolution. Wiley."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Evolutionary Programming (EP)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/Experiment",
