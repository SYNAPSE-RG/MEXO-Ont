    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2013"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1016/j.knosys.2013.03.014"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/SwarmIntelligence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Population-based algorithm inspired by social-spider colony behavior, including gender-based operators and vibrations on the web. Reference: Cuevas, E., Cienfuegos, M., Zaldívar, D., & Pérez-Cisneros, M. (2013). A swarm optimization algorithm inspired in the social behavior of the spider. Knowledge-Based Systems, 49, 1–12. https://doi.org/10.1016/j.knosys.2013.03.014"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Social Spider Optimization (SSO)"
  } ]
