  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/SwarmIntelligence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Swarm algorithm based on the foraging and anti-predation behavior of sparrows, typically involving producers, scroungers, and awareness mechanisms. Reference: Xue, J., & Shen, B. (2020). A novel swarm intelligence optimization approach: Sparrow search algorithm. Systems Science & Control Engineering, 8(1), 22–34."
  } ],
