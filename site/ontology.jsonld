    "@language" : "en",
    "@value" : "A reusable metaheuristic method represented as a SKOS concept."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Metaheuristic algorithm"
