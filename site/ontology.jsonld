  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/EvolutionaryComputation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Evolutionary framework that combines elite solutions via structured combination and explores trajectories between them (path relinking). Reference: Glover, F. (1998). A template for scatter search and path relinking. In J.-K. Hao, E. Lutton, E. Ronald, M. Schoenauer, & D. Snyers (Eds.), Artificial Evolution (AE 1997) (LNCS 1363, pp. 13–54). Springer. https://doi.org/10.1007/BFb0026589"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Scatter Search & Path Relinking"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/SearchSpace",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
