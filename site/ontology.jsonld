  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A planned execution of an algorithm on a problem under a defined configuration."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Experiment"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/FireflyAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2009"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1007/978-3-642-04944-6_14"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/SwarmIntelligence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Swarm algorithm where agents are attracted by brighter (better) solutions with attractiveness decreasing with distance. Reference: Yang, X.-S. (2009). Firefly algorithms for multimodal optimization. In O. Watanabe & T. Zeugmann (Eds.), Stochastic Algorithms: Foundations and Applications (SAGA 2009) (LNCS 5792, pp. 169–178). Springer. https://doi.org/10.1007/978-3-642-04944-6_14"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Firefly Algorithm (FA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/FireworksAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2010"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1007/978-3-642-13495-1_44"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/SwarmIntelligence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Swarm-inspired method that explores search space via explosion sparks around promising solutions, with adaptive spark numbers/amplitudes. Reference: Tan, Y., & Zhu, Y. (2010). Fireworks algorithm for optimization. In Y. Tan, Y. Shi, & K. C. Tan (Eds.), Advances in Swarm Intelligence (ICSI 2010) (LNCS 6145, pp. 355–364). Springer. https://doi.org/10.1007/978-3-642-13495-1_44"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Fireworks Algorithm (FWA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/FlowerPollinationAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2012"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1007/978-3-642-32894-7_27"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/BioInspired"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Nature-inspired method modeling global and local pollination, typically mixing Lévy flights (global) with local random walks. Reference: Yang, X.-S. (2012). Flower pollination algorithm for global optimization. In U. K. Chakraborty & A. K. Roy (Eds.), Unconventional Computation and Natural Computation (pp. 240–249). Springer. https://doi.org/10.1007/978-3-642-32894-7_27"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Flower Pollination Algorithm (FPA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/GRASP",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1995"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1007/BF01096763"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/TrajectoryBased"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Multi-start metaheuristic alternating randomized greedy construction with local search improvement. Reference: Feo, T. A., & Resende, M. G. C. (1995). Greedy randomized adaptive search procedures. Journal of Global Optimization, 6, 109–133. https://doi.org/10.1007/BF01096763"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://dbpedia.org/resource/GRASP_(metaheuristic)"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "GRASP (Greedy Randomized Adaptive Search Procedure)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/GeneticAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1975"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/EvolutionaryComputation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Population-based evolutionary search using selection, crossover, and mutation operators. Reference: Holland, J. H. (1975). Adaptation in Natural and Artificial Systems. University of Michigan Press."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://dbpedia.org/resource/Genetic_algorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Genetic Algorithm (GA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/GeneticProgramming",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1992"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://mitpress.mit.edu/9780262111706/genetic-programming/"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/EvolutionaryComputation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Evolutionary computation where candidate solutions are programs (often trees) evolved via genetic operators. Reference: Koza, J. R. (1992). Genetic Programming: On the Programming of Computers by Means of Natural Selection. MIT Press."
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://dbpedia.org/resource/Genetic_programming"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Genetic Programming (GP)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/GlowwormSwarmOptimization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2005"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/SwarmIntelligence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Swarm algorithm inspired by glowworm luminescence (luciferin) to locate multiple optima in multimodal landscapes. Reference: Krishnanand, K. N., & Ghose, D. (2005). Detection of multiple source locations using a glowworm metaphor with applications to collective robotics. In Proceedings of the IEEE Swarm Intelligence Symposium (pp. 84–91). IEEE."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Glowworm Swarm Optimization (GSO)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/GravitationalSearchAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2009"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1016/j.ins.2009.03.004"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/PhysicsInspired"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Population-based optimization inspired by Newtonian gravity and mass interactions, where agents attract each other proportionally to fitness. Reference: Rashedi, E., Nezamabadi-Pour, H., & Saryazdi, S. (2009). GSA: A gravitational search algorithm. Information Sciences, 179(13), 2232–2248. https://doi.org/10.1016/j.ins.2009.03.004"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Gravitational Search Algorithm (GSA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/GreatDeluge",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1993"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1016/0021-9991(93)90332-9"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/TrajectoryBased"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Trajectory method that accepts solutions below a decreasing 'water level' threshold, balancing exploration and convergence. Reference: Dueck, G. (1993). New optimization heuristics: The great deluge algorithm and the record-to-record travel. Journal of Computational Physics, 104(1), 86–92. https://doi.org/10.1016/0021-9991(93)90332-9"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Great Deluge Algorithm (GDA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/GreyWolfOptimizer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2014"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1016/j.advengsoft.2013.12.007"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/SwarmIntelligence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Swarm algorithm mimicking leadership hierarchy and hunting behavior of grey wolves using encircling and attacking phases. Reference: Mirjalili, S., Mirjalili, S. M., & Lewis, A. (2014). Grey wolf optimizer. Advances in Engineering Software, 69, 46–61. https://doi.org/10.1016/j.advengsoft.2013.12.007"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Grey Wolf Optimizer (GWO)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/GuidedLocalSearch",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1999"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1007/3-540-48431-0_10"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/TrajectoryBased"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Augments local search with penalties on undesirable features to help escape local minima while maintaining intensification. Reference: Voudouris, C., & Tsang, E. (1999). Guided local search and its application to the traveling salesman problem. In D. Corne, M. Dorigo, & F. Glover (Eds.), New Ideas in Optimization (pp. 119–133). McGraw-Hill. https://doi.org/10.1007/3-540-48431-0_10"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Guided Local Search (GLS)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/HarmonySearch",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2001"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1177/003754970107600201"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/BioInspired"
  }, {
    "@id" : "https://w3id.org/mexo/HumanSocioInspired"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Music-inspired metaheuristic that improvises new solutions by memory consideration, pitch adjustment, and random selection. Reference: Geem, Z. W., Kim, J. H., & Loganathan, G. V. (2001). A new heuristic optimization algorithm: Harmony search. Simulation, 76(2), 60–68. https://doi.org/10.1177/003754970107600201"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://dbpedia.org/resource/Harmony_search"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Harmony Search (HS)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/HarrisHawksOptimization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2019"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1016/j.future.2019.02.028"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/SwarmIntelligence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Population-based method inspired by cooperative hunting of Harris hawks, combining exploration and multiple exploitation strategies. Reference: Heidari, A. A., Mirjalili, S., Faris, H., Aljarah, I., Mafarja, M., & Chen, H. (2019). Harris hawks optimization: Algorithm and applications. Future Generation Computer Systems, 97, 849–872. https://doi.org/10.1016/j.future.2019.02.028"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Harris Hawks Optimization (HHO)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/HumanSocioInspired",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicFamily"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Human/socio-inspired metaheuristics"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/ImperialistCompetitiveAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2007"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1109/CEC.2007.4425083"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/SwarmIntelligence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Socio-political inspired population algorithm where empires assimilate colonies and compete for power, driving the search toward strong imperialists. Reference: Atashpaz-Gargari, E., & Lucas, C. (2007). Imperialist competitive algorithm: An algorithm for optimization inspired by imperialistic competition. In 2007 IEEE Congress on Evolutionary Computation (pp. 4661–4667). IEEE. https://doi.org/10.1109/CEC.2007.4425083"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Imperialist Competitive Algorithm (ICA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/InvasiveWeedOptimization",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2006"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1016/j.ecolmodel.2005.07.010"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/BioInspired"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Plant colonization-inspired algorithm where weeds reproduce and disperse seeds with decreasing variance to intensify search. Reference: Mehrabian, A. R., & Lucas, C. (2006). A novel numerical optimization algorithm inspired from weed colonization. Ecological Modelling, 179(4), 355–366. https://doi.org/10.1016/j.ecolmodel.2005.07.010"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Invasive Weed Optimization (IWO)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/IteratedLocalSearch",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2003"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1007/978-1-4419-1665-5_4"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/TrajectoryBased"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Metaheuristic that repeatedly perturbs a locally optimal solution and re-applies local search to find better basins. Reference: Lourenço, H. R., Martin, O. C., & Stützle, T. (2003). Iterated local search. In F. Glover & G. A. Kochenberger (Eds.), Handbook of Metaheuristics (pp. 320–353). Springer. https://doi.org/10.1007/978-1-4419-1665-5_4"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Iterated Local Search (ILS)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/LargeNeighborhoodSearch",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1998"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1007/3-540-49481-2_30"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/TrajectoryBased"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Destroy-and-repair style neighborhood search where large parts of a solution are removed and reconstructed to explore distant alternatives. Reference: Shaw, P. (1998). Using constraint programming and local search methods to solve vehicle routing problems. In M. Maher & J.-F. Puget (Eds.), Principles and Practice of Constraint Programming (CP’98) (pp. 417–431). Springer. https://doi.org/10.1007/3-540-49481-2_30"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Large Neighborhood Search (LNS)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/LeagueChampionshipAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2009"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1109/SoCPaR.2009.21"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/HumanSocioInspired"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Sport-inspired population algorithm modeling league competitions where teams (solutions) play and improve via competition outcomes. Reference: Kashan, A. H. (2009). League championship algorithm: A new algorithm for numerical function optimization. In 2009 International Conference of Soft Computing and Pattern Recognition (pp. 43–48). IEEE. https://doi.org/10.1109/SoCPaR.2009.21"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "League Championship Algorithm (LCA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/MEXO",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-30"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "OWL ontology for representing metaheuristic algorithms, benchmark problems and instances, experiment configurations, parameters, computational budgets, stopping criteria, and aggregate performance results."
  } ],
  "http://purl.org/dc/terms/hasPart" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-09-01"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "MEXO — Metaheuristic Experiment Ontology"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "mexo"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@id" : "https://w3id.org/mexo/"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "5.2.0"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/MOEAD",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2007"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://doi.org/10.1109/TEVC.2007.892759"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/EvolutionaryComputation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Multiobjective evolutionary algorithm based on decomposition of a MOP into scalar subproblems and neighborhood cooperation. Reference: Zhang, Q., & Li, H. (2007). MOEA/D: A multiobjective evolutionary algorithm based on decomposition. IEEE Transactions on Evolutionary Computation, 11(6), 712–731. https://doi.org/10.1109/TEVC.2007.892759"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "MOEA/D"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/MarinePredatorsAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "2020"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/SwarmIntelligence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Nature-inspired population algorithm based on predator–prey foraging strategies using Lévy and Brownian movements. Reference: Faramarzi, A., Heidarinejad, M., Mirjalili, S., & Gandomi, A. H. (2020). Marine predators algorithm: A nature-inspired metaheuristic. Expert Systems with Applications, 152, 113377."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Marine Predators Algorithm (MPA)"
  } ]
}, {
  "@id" : "https://w3id.org/mexo/MemeticAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#gYear",
    "@value" : "1989"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://w3id.org/mexo/MetaheuristicAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/mexo/EvolutionaryComputation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Hybrid evolutionary framework that combines population search with intensive local improvement (\"memes\"). Reference: Moscato, P. (1989). On evolution, search, optimization, genetic algorithms and martial arts: Toward memetic algorithms (Technical Report C3P 826). California Institute of Technology."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Memetic Algorithm (MA)"
  } ]
}, {
