  } ]
}, {
  "@id" : "https://w3id.org/mexo/MetaheuristicTaxonomy",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-12-15"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "A pragmatic SKOS taxonomy of widely-used metaheuristic algorithms, grouped by family. Each algorithm concept includes an APA reference to its original publication."
  } ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "https://w3id.org/mexo/MEXO"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
